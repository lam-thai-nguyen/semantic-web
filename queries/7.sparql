# Which Adventure movies were released in 2026?

PREFIX schema: <https://schema.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?movie_name ?genre ?date
WHERE {
    ?id a schema:Movie .
    ?id schema:name ?movie_name .
    ?id schema:datePublished ?date .
    ?id schema:genre ?g .
    ?g schema:name ?genre .
    FILTER (YEAR(?date) = 2026)
    FILTER (?genre = "Adventure")
}
LIMIT 10